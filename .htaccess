Options -Indexes

# Bảo vệ file nhạy cảm (KHÔNG chặn .json — manifest.json ở gốc site phải công khai cho PWA;
# các .json thật sự nhạy cảm như config/products.json đã có config/.htaccess riêng chặn cả thư mục,
# và sql/schema.sql không được đẩy lên server — xem .github/workflows/deploy.yml)
<FilesMatch "(^\.|\.(sql|md|lock|yml|yaml|log)$|composer\.)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Ép HTTPS (Hostinger cấp SSL miễn phí — bật trong hPanel trước)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=()"

  # QUAN TRỌNG: Hostinger có lớp CDN riêng (hCDN) cache .css/.js theo ĐÚNG URL trong 7 ngày
  # (Cache-Control: max-age=604800 mặc định) và KHÔNG tự xoá cache khi bạn deploy file mới qua
  # FTP — CDN vẫn phát bản cũ cho MỌI người xem, không chỉ ai từng ghé trước đó. Ép "no-cache"
  # (không phải "no-store") để CDN/trình duyệt luôn phải hỏi lại server gốc trước khi dùng bản
  # đã lưu: nếu file chưa đổi, server trả 304 rất nhẹ; nếu đã đổi, luôn lấy đúng bản mới nhất.
  # Đây mới là nguyên nhân sâu xa khiến trang từng hiện tên thương hiệu cũ dù đã deploy đúng.
  <FilesMatch "\.(css|js)$">
    Header always set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
